# Optional: GitHub OAuth app client ID for connecting private GitHub library URLs.
# Public library.json URLs work without this.
# VITE_GITHUB_CLIENT_ID=

# Optional: OAuth callback host used with VITE_GITHUB_CLIENT_ID (your own GitHub OAuth app).
# VITE_AUTH_SERVICE_URL=

# Optional: Cloudflare tunnel hostname for remote HMR. Leave unset for local http://localhost:3000.
# VITE_EXTERNAL_DEV_HOST=

# Optional: build identity shown in Settings (CI injects these; local defaults to "dev").
# VITE_APP_VERSION=
# VITE_APP_GIT_SHA=

# Optional: base URL for Marginalia.Help content (manifest, articles, tours, search index).
# Dev default: /help-content/ (Vite serves ../Marginalia.Help and hot-reloads HelpPanel on file changes).
# Prod default: https://raw.githubusercontent.com/marginaliabible/Marginalia.Help/main/
# VITE_HELP_CONTENT_URL=

# Hosted overlay (private sibling repo). Put this in .env.local, never commit it.
# VITE_SANCTUM=1
# VITE_GOOGLE_CLIENT_ID=
# VITE_MICROSOFT_CLIENT_ID=
# VITE_STORAGE_PUBLIC_BASE_URL=
