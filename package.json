{
  "name": "marginalia",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "start:sanctum": "node scripts/with-sanctum.mjs start",
    "build": "tsc && vite build",
    "build:sanctum": "node scripts/with-sanctum.mjs build",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:sanctum": "npm --prefix ../Marginalia.UI.Sanctum test",
    "generate:scrollmapper": "node scripts/generate-scrollmapper.js",
    "find:near-duplicates": "node scripts/find-near-duplicate-translations.js"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "idb": "^8.0.3",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^4.10.38",
    "react-select": "^5.10.2",
    "stemmer": "^2.0.1"
  },
  "devDependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bootstrap": "^5.2.11",
    "@types/jasmine": "~6.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-redux": "^9.3.0",
    "sass": "^1.100.0",
    "ts-jest": "^29.4.11",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-svgr": "^5.2.0"
  }
}
